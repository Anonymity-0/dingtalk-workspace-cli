        "name": {
          "property": "fileName",
          "required": false
        },
        "space-id": {
          "property": "spaceId",
          "required": false
        },
        "workspace": {
          "property": "workspaceId",
          "required": false
        },
        "dry-run": {
          "property": "dryRun",
