        "content": {
          "property": "replacement",
          "required": true
        },
        "regex": {
          "property": "regex",
          "required": false,
          "interface_type": "boolean"
        },
        "space-id": {
          "property": "spaceId",
          "required": false
        },
        "workspace": {
          "property": "workspaceId",
          "required": false
        },
        "dry-run": {
          "property": "dryRun",
          "required": false,
          "interface_type": "boolean"
        }
